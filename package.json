{
  "name": "@dysektai/pi-lsp",
  "version": "0.1.0",
  "description": "Managed, cross-platform LSP integration for Pi with an interactive control panel and first-class C#/.NET support.",
  "keywords": [
    "pi-package",
    "pi",
    "lsp",
    "language-server",
    "csharp",
    "dotnet"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DysektAI/pi-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/DysektAI/pi-lsp/issues"
  },
  "homepage": "https://github.com/DysektAI/pi-lsp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
